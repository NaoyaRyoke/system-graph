{
  "mcpServers": {
    "system-graph": {
      "command": "npx",
      "args": [
        "-y",
        "--package=github:NaoyaRyoke/system-graph#refactor/company-mcp-template",
        "system-graph"
      ],
      "env": {
        "SYSTEM_GRAPH_CONFIG": "/opt/system-graph/runtime-stdio.json",
        "SYSTEM_GRAPH_ENGINE": "/opt/system-graph/target/debug/hybrid-engine-host"
      }
    }
  }
}
